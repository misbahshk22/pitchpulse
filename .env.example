# Matchday Platform Configuration

PORT=3000

# Football Data API (Optional - simulation mode runs automatically if empty)
# Get a key from https://www.api-football.com/ or RapidAPI
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io

# Polling intervals (adaptive polling)
POLLING_INTERVAL_LIVE_SEC=30
POLLING_INTERVAL_IDLE_MIN=180

# 1. Telegram Bot (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# 2. Discord Bot (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# 3. WhatsApp Cloud API (Meta for Developers -> WhatsApp)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=matchday_verify_secret

# Database path (default: SQLite local database)
DATABASE_PATH=./matchday.db
